# ---------- Database (PostgreSQL) ----------
# Local example: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Supabase / Neon / Railway: paste the connection string they give you.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------- Authentication ----------
# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ---------- Site ----------
# Public URL of the website (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://www.example.com

# ---------- First administrator ----------
# Used ONCE to create the first admin account if no users exist yet.
# Remove these after the first login (or change the password from /admin/users).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Media storage ----------
# Option A (default): local disk. Files are written to UPLOAD_DIR and served from /api/media/file/...
UPLOAD_DIR=./uploads

# Option B: S3-compatible cloud storage (AWS S3, Cloudflare R2, Supabase Storage S3 endpoint, DigitalOcean Spaces).
# When S3_BUCKET is set, uploads go to the bucket instead of local disk.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket/CDN (no trailing slash). If omitted, files are streamed through the app.
# S3_PUBLIC_URL=https://cdn.example.com
